{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?path=:path*"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/login/",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(dashboard|products|blogs|inquiries)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(dashboard|products|blogs|inquiries)/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/product-category",
      "destination": "/product-category/index.html"
    },
    {
      "source": "/product-category/",
      "destination": "/product-category/index.html"
    },
    {
      "source": "/product-category/:category/page/:num",
      "destination": "/product/index.html"
    },
    {
      "source": "/product-category/:category/page/:num/",
      "destination": "/product/index.html"
    },
    {
      "source": "/product/page/:num",
      "destination": "/product/index.html"
    },
    {
      "source": "/product/page/:num/",
      "destination": "/product/index.html"
    },
    {
      "source": "/product/:slug",
      "destination": "/product-detail/index.html"
    },
    {
      "source": "/product/:slug/",
      "destination": "/product-detail/index.html"
    }
  ]
}
